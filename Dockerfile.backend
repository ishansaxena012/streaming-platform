# Build stage
FROM node:22-slim AS builder

WORKDIR /app

# Install pnpm and nest cli globally, and openssl for Prisma
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm @nestjs/cli

# Copy root lockfiles and workspaces
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy all packages/apps package.json files to cache dependency installation
COPY apps/streamer-backend/package.json ./apps/streamer-backend/
COPY apps/streamer-worker/package.json ./apps/streamer-worker/
COPY apps/streamer-user-portal/package.json ./apps/streamer-user-portal/

# Configure pnpm network limits and retries to handle connection resets
RUN pnpm config set fetch-retries 10 && \
    pnpm config set fetch-retry-mintimeout 20000 && \
    pnpm config set fetch-retry-maxtimeout 120000 && \
    pnpm config set network-concurrency 4

# Install dependencies (forcing no-frozen-lockfile check via environment variable)
RUN npm_config_frozen_lockfile=false pnpm install

# Copy the rest of the application code
COPY . .

# Generate Prisma Client (so build succeeds)
RUN npx prisma generate --schema=apps/streamer-backend/prisma/schema.prisma

# Build the backend project
RUN npm run build:backend

# Prune development dependencies to keep image size small
# Note: prune recreates node_modules and deletes the generated Prisma Client
RUN CI=true pnpm prune --prod

# Generate Prisma Client AFTER prune so it survives in node_modules
RUN npx prisma generate --schema=apps/streamer-backend/prisma/schema.prisma

# Production runner stage
FROM node:22-slim AS runner

# Install openssl (required by Prisma engines)
RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy root configurations and pruned node_modules
COPY --from=builder /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/apps/streamer-backend/prisma ./apps/streamer-backend/prisma
COPY --from=builder /app/apps/streamer-backend/prisma.config.ts ./apps/streamer-backend/prisma.config.ts

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# Use non-root user for security
USER node

# Start backend application (runs database migrations first using the direct DB URL)
CMD ["sh", "-c", "cd apps/streamer-backend && DATABASE_URL=\"${DIRECT_URL:-$DATABASE_URL}\" /app/node_modules/.bin/prisma migrate deploy && cd /app && node dist/apps/streamer-backend/main.js"]
