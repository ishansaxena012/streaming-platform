generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum VideoStatus {
  PENDING
  PROCESSING
  READY_FOR_REVIEW
  PUBLISHED
  REJECTED
  FAILED
  APPROVED
}

enum AdminRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?
  name     String
  role     Role    @default(USER)

  subscriptionPlan      SubscriptionPlan @default(FREE)
  subscriptionExpiresAt DateTime?

  googleId  String? @unique
  avatarUrl String?

  adminRequestStatus AdminRequestStatus @default(NONE)
  adminRequestedAt   DateTime?

  videoViews    VideoView[]
  videoProgress VideoProgress[]

  uploadedVideos Video[]
  approvedVideos Video[] @relation("ApprovedVideos")

  watchHistory WatchHistory[]
  watchlist    Watchlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionPlan])
}

model Video {
  id String @id @default(cuid())

  title       String
  description String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  videoUrl     String?
  thumbnailUrl String?

  duration Int?

  isPremium Boolean @default(false)

  videoViews    VideoView[]
  videoProgress VideoProgress[]

  hlsManifestUrl String?

  watchlists Watchlist[]

  processingStartedAt DateTime?
  processedAt         DateTime?

  processingProgress Int @default(0)

  processingError String?
  retryCount      Int @default(0)

  status VideoStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uploadedById String
  uploadedBy   User @relation(fields: [uploadedById], references: [id])

  approvedById String?
  approvedBy   User? @relation("ApprovedVideos", fields: [approvedById], references: [id])

  watchHistory WatchHistory[]

  @@index([status])
  @@index([isPremium])
  @@index([categoryId])
  @@index([uploadedById])
  @@index([createdAt])
}

model WatchHistory {
  id String @id @default(cuid())

  userId  String
  videoId String

  progressSeconds Int @default(0)

  completed Boolean @default(false)

  lastWatchedAt DateTime @default(now()) @updatedAt

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Category {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  createdAt DateTime @default(now())

  videos Video[]
}

model Watchlist {
  id String @id @default(cuid())

  createdAt DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  videoId String
  video   Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model VideoView {
  id String @id @default(cuid())

  userId String?
  videoId String

  createdAt DateTime @default(now())

  user  User? @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@index([videoId])
  @@index([userId])
}

model VideoProgress {
  id String @id @default(cuid())

  userId  String
  videoId String

  watchedSeconds Int @default(0)

  completed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  video Video @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}